rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each student owns their schedule; only they (signed in) can touch it.
    match /users/{uid}/classes/{classId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // No other document path is reachable from the app. Deny the rest.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
